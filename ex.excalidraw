      "updated": 1782566519501,
      "link": null,
      "locked": false,
      "text": "        \n    get the loits list\n    \n    get the state\n\nloop over the state of json:\n    \n        \n        get the logits list\n         \n        get the state of the object\n        \n         filter the logits and get the valid one matching the state\n    \n        append it to the generated ids\n         \n        loop on the state of the object until end of parameters:\n            check the begin of the object\n            check the prompt\n            check the colon\n            add the original prompt\n            check the comma\n            check the name\n            check the function name\n            check the comma\n            check the parameters\n            inside parameters\n            check the end of parameters\n            raise the end of parameters\n       change the state of the file to comma and start obj\n            \n            \n            \n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "        \n    get the loits list\n    \n    get the state\n\nloop over the state of json:\n    \n        \n        get the logits list\n         \n        get the state of the object\n        \n         filter the logits and get the valid one matching the state\n    \n        append it to the generated ids\n         \n        loop on the state of the object until end of parameters:\n            check the begin of the object\n            check the prompt\n            check the colon\n            add the original prompt\n            check the comma\n            check the name\n            check the function name\n            check the comma\n            check the parameters\n            inside parameters\n            check the end of parameters\n            raise the end of parameters\n       change the state of the file to comma and start obj\n            \n            \n            \n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
